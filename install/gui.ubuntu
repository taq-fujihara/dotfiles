#!/usr/bin/env bash

# Zed
curl -f https://zed.dev/install.sh | sh

# VSCode
wget https://code.visualstudio.com/insiders/download/linux/deb -O /tmp/vscode-insiders.deb && \
  sudo apt install /tmp/vscode-insiders.deb

# LibreOffice
sudo add-apt-repository ppa:libreoffice/ppa && \
  sudo apt update && \
  sudo apt install libreoffice
