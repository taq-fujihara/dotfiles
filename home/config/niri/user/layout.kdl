layout {
    gaps 15

    focus-ring {
        width 5
    }

    center-focused-column "never"
    always-center-single-column true

    preset-column-widths {
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }
}

