layout {
    gaps 20

    focus-ring {
        width 6
        inactive-color "#505050"
    }

    center-focused-column "never"
    always-center-single-column true

    // preset-column-widths {
    //     proportion 0.33333
    //     proportion 0.5
    //     proportion 0.66667
    //     proportion 1.0
    // }

    default-column-width { proportion 0.5; }
}

overview {
    zoom 0.4
}

window-rule {
    geometry-corner-radius 10
}
