binds {
    Mod+Slash hotkey-overlay-title="Application Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+Return hotkey-overlay-title="Application Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+Q repeat=false { close-window; }
    Mod+W repeat=false { toggle-overview; }

    Mod+E hotkey-overlay-title="Open File Manager" { spawn-sh "dfiles open -n ~"; }
    Mod+B hotkey-overlay-title="Open browser" { spawn "brave-origin"; }
    Mod+T hotkey-overlay-title="Open Terminal" { spawn "wezterm"; }
    Mod+Shift+T hotkey-overlay-title="Open Terminal (Herdr)" { spawn "ghostty" "-e" "herdr"; }
    Mod+D hotkey-overlay-title="Open Dendron" { spawn-sh "code-insiders $DENDRON_PERSONAL_NOTE_ROOT/dendron.code-workspace"; }
    Mod+Shift+D hotkey-overlay-title="Open Dendron (All)" { spawn-sh "code-insiders $DENDRON_ROOT/dendron.code-workspace"; }
    Mod+Period { spawn "emoji-picker"; }
    Mod+Tab { spawn "sh" "-c" "niri-rotate-right-columns.sh"; }

    Mod+R { switch-preset-column-width; }
    Mod+S { toggle-column-tabbed-display; }
    Mod+F { maximize-column; }
    Mod+M { set-column-width "66.667%"; }
    Mod+Shift+M { set-column-width "33.333%"; }

    Mod+H { focus-column-or-monitor-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-or-monitor-right; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }

    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-workspace-down; }
    Mod+Ctrl+K { focus-workspace-up; }
    Mod+Ctrl+L { focus-monitor-right; }

    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-workspace-down; }
    Mod+Shift+Ctrl+K { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }

    Mod+U { consume-or-expel-window-left; }
    Mod+I { consume-or-expel-window-right; }
}
