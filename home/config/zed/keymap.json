// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "secondary-h": "workspace::ActivatePaneLeft",
      "secondary-l": "workspace::ActivatePaneRight",
      "secondary-j": "workspace::ActivatePaneDown",
      "secondary-k": "workspace::ActivatePaneUp",
      "f5": "debugger::Start",
      "f10": "debugger::StepOver",
      "f11": "debugger::StepInto",
      "shift-f11": "debugger::StepOut",
    },
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore",
      "shift-space": "editor::ShowCompletions",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "L": "pane::ActivateNextItem",
      "H": "pane::ActivatePreviousItem",
      "|": "pane::SplitRight",
      "-": "pane::SplitDown",
      "s": "vim::HelixJumpToWord",
      "space w": "workspace::Save",
      "space c": "pane::CloseActiveItem",
      "space q": "pane::CloseActiveItem",
      "space o": "project_panel::ToggleFocus",
      "space e": "workspace::ToggleRightDock",
      "space n": "workspace::NewFile",
      "space z": "workspace::ToggleZoom",
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f w": "pane::DeploySearch",
      "space f c": [
        "workspace::SendKeystrokes",
        "v i w ctrl-shift-f enter",
      ],
      "space f r": "vim::ToggleRegistersView",
      "space l r": "editor::Rename",
      "space l R": "editor::FindAllReferences",
      "space l s": "outline::Toggle",
      "space l S": "outline_panel::ToggleFocus",
      "space l a": "editor::ToggleCodeActions",
      "space g g": ["task::Spawn", { "task_name": "start lazygit" }],
      "g r i": "editor::GoToImplementation",
      "left": "vim::ResizePaneLeft",
      "right": "vim::ResizePaneRight",
      "shift-up": "vim::ResizePaneDown",
      "shift-down": "vim::ResizePaneUp",
      "shift-left": "vim::ResizePaneRight",
      "shift-right": "vim::ResizePaneLeft",
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      ";": "command_palette::Toggle",
      "space /": "editor::ToggleComments",
      "space y": [
        "workspace::SendKeystrokes",
        "\" + y"
      ],
      "space p": "editor::Paste",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !(showing_code_actions || showing_completions)",
    "bindings": {
      "up": "vim::ResizePaneUp",
      "down": "vim::ResizePaneDown",
    },
  },
  {
    "context": "VimControl && !menu && vim_mode == normal",
    "bindings": {
      "enter": "editor::OpenExcerpts",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "secondary-h": "workspace::ActivatePaneLeft",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "c": "project_panel::Duplicate",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "space e": "workspace::ToggleRightDock",
      "space o": "project_panel::ToggleFocus",
      "l": "project_panel::OpenPermanent",
    },
  },
  // Closing Various Panes
  {
    "context": "ProjectSearchBar || ProjectSearchView",
    "bindings": {
      "escape escape": "pane::CloseActiveItem",
    },
  },
  {
    "context": "OutlinePanel",
    "bindings": {
      "space q": "outline_panel::Toggle",
      "space c": "outline_panel::Toggle",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "space g g": "git_panel::Toggle",
    },
  },
  {
    "context": "AgentPanel > Editor && vim_mode != insert",
    "bindings": {
      "space q": "agent::Toggle",
      "space c": "agent::Toggle",
    },
  },
  // Turbo Logs
  // - py
  {
    "context": "Editor && vim_mode == normal && extension == py",
    "bindings": {
      "space l l": [
        "workspace::SendKeystrokes",
        "m t \" t y i w o p r i n t ( \" 🚀 space escape \" % p a space ~ space escape \" t p a : escape l a , space escape \" t p ` t",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == visual && extension == py",
    "bindings": {
      "space l l": [
        "workspace::SendKeystrokes",
        "m t \" t y o p r i n t ( \" 🚀 space escape \" % p a space ~ space escape \" t p a : escape l a , space escape \" t p ` t",
      ],
    },
  },
  // - js/ts
  {
    "context": "Editor && vim_mode == normal && (extension == js || extension == ts || extension == vue)",
    "bindings": {
      "space l l": [
        "workspace::SendKeystrokes",
        "m t \" t y i w o c o n s o l e . l o g ( \" 🚀 space escape \" % p a space ~ space escape \" t p a : escape l a , space escape \" t p A ; escape ` t",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == visual && (extension == js || extension == ts || extension == vue)",
    "bindings": {
      "space l l": [
        "workspace::SendKeystrokes",
        "m t \" t y o c o n s o l e . l o g ( \" 🚀 space escape \" % p a space ~ space escape \" t p a : escape l a , space escape \" t p A ; escape ` t",
      ],
    },
  },
  // - java
  {
    "context": "Editor && vim_mode == normal && extension == java",
    "bindings": {
      "space l l": [
        "workspace::SendKeystrokes",
        "m t \" t y i w o S y s t e m . o u t . p r i n t l n ( \" 🚀 space escape \" % p a space ~ space escape \" t p a : space escape l a space + space escape \" t p A ; escape ` t",
      ],
    },
  },
  {
    "context": "Editor && vim_mode == visual && extension == java",
    "bindings": {
      "space l l": [
        "workspace::SendKeystrokes",
        "m t \" t y o S y s t e m . o u t . p r i n t l n ( \" 🚀 space escape \" % p a space ~ space escape \" t p a : space escape l a space + space escape \" t p A ; escape ` t",
      ],
    },
  },
]
